generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  price       Float?
  stock       Int?     @default(0)
  imageUrl    String?
  category    String?
  rawData     Json     // Store the full scrape payload here
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
