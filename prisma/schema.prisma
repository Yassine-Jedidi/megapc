generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
}

model Product {
  id                String   @id @default(cuid())
  externalId        String?  // The "_id" from the JSON
  slug              String   @unique // The "lien" from the JSON
  title             String
  titleFr           String?  // French alternate title from title_fr
  description       String?  // HTML description from miniDescription_fr
  price             Float?
  
  // Sale/Promotion fields
  onSale            Boolean  @default(false)
  salePrice         Float?
  discount          Float?
  
  stock             Int?     @default(0)
  
  // Status flags
  isNew             Boolean  @default(false)
  isArriving        Boolean  @default(false)
  quoteMode         Boolean  @default(false) // devis — show "Request Quote" instead of price
  commande48H       Boolean  @default(false) // 48h delivery
  checkStock        Boolean  @default(true)  // checkStockWhenPurchased
  isPrivate         Boolean  @default(false) // productpriv
  viewCount         Int      @default(0)
  hasHistory        Boolean  @default(false)
  priceTrend        String?  // 'up', 'down', or null
  
  // Category relationship
  category          Category? @relation("MainCategory", fields: [categoryId], references: [id])
  categoryId        String?
  
  subCategory       Category? @relation("SubCategory", fields: [subCategoryId], references: [id])
  subCategoryId      String?
  
  // Specs for filtering
  cpu               String?
  gpu               String?
  
  // Media
  images            String[] // All photos from gallerie.urlPhoto

  // Scraper metadata
  rawData           Json
  siteCreateDate    DateTime? // the "create_date" from the site
  siteUpdateDate    DateTime? // the "update_date" from the site (or gallerie update)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relationships
  priceHistory      PriceHistory[]

  // High-cardinality FK indexes — essential for category filtering
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([hasHistory])
  @@index([cpu])
  @@index([gpu])

  // Composite indexes for the most common catalog query patterns:
  // (category + sort column) avoids a separate sort step entirely
  @@index([categoryId, siteCreateDate]) // newest in category
  @@index([categoryId, price])          // price sort in category
  @@index([categoryId, viewCount])      // popular in category

  // salePrice index: supports "promo" filter (salePrice NOT NULL) and sorting
  @@index([salePrice])

  // price range filter + global sort
  @@index([price])
  @@index([siteCreateDate])
  @@index([viewCount])

  // stock: used as stock > 0 — B-tree will use this for inequality scans
  @@index([stock])
  @@index([priceTrend])

  // Note: Boolean indexes (onSale, isNew, etc.) intentionally removed.
  // Low-cardinality booleans are ignored by PostgreSQL's query planner.
  // They add write overhead with no read benefit.
  //
  // Note: @@index([title]) removed — B-tree doesn't help ILIKE/contains.
  // For full text search, a pg_trgm GIN index via raw migration would be needed.
}

model Category {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  externalId      String?   @unique
  
  products        Product[] @relation("MainCategory")
  subProducts     Product[] @relation("SubCategory")
}

model PriceHistory {
  id        String   @id @default(cuid())
  price     Float
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  createdAt DateTime @default(now())
}
